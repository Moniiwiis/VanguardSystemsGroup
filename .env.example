DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# Para producción o entorno MySQL/WAMP:
# DB_ENGINE=mysql
# DB_NAME=sgr_db
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# SMTP para recuperación de contraseña. Configura una cuenta propia y su contraseña de aplicación.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=tu-cuenta@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicación
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=tu-cuenta@gmail.com
EMAIL_TIMEOUT=10